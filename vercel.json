{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "./", "framework": "nextjs" },
    "ml": { "root": "services/ml/" }
  },
  "rewrites": [
    { "source": "/api/ml/(.*)", "destination": { "service": "ml" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
